{
  "name": "minecraft-ai-society",
  "version": "0.1.0",
  "private": true,
  "description": "Minecraft 自律型AI社会シミュレーション (Mineflayer + Ollama + SQLite + VOICEVOX)",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/main.js",
    "mock": "node --disable-warning=ExperimentalWarning src/main.js --mock",
    "test": "node --test test/*.test.js",
    "test-server": "node --disable-warning=ExperimentalWarning scripts/test-server.js",
    "smoke": "node --disable-warning=ExperimentalWarning scripts/smoke-actions.js",
    "check": "node --disable-warning=ExperimentalWarning scripts/check-env.js",
    "voices": "node --disable-warning=ExperimentalWarning scripts/list-voices.js",
    "history": "node --disable-warning=ExperimentalWarning scripts/history.js",
    "setup": "node --disable-warning=ExperimentalWarning scripts/setup.js",
    "launch": "node --disable-warning=ExperimentalWarning scripts/launch.js",
    "postinstall": "patch-package",
    "test-body": "node scripts/test-body.js"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "minecraft-data": "^3.119.0",
    "minecraft-protocol": "^1.68.0",
    "mineflayer": "4.39.0",
    "mineflayer-armor-manager": "^2.0.1",
    "mineflayer-auto-eat": "^3.3.6",
    "mineflayer-collectblock": "^1.6.0",
    "mineflayer-pathfinder": "2.4.5",
    "mineflayer-pvp": "1.3.2",
    "patch-package": "^8.0.1",
    "prismarine-item": "^1.18.0",
    "prismarine-nbt": "^2.8.0",
    "vec3": "^0.2.0"
  },
  "devDependencies": {
    "flying-squid": "^1.12.0"
  }
}
